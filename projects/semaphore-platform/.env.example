# Copy to .env with `make secrets` (generates random passwords). Never commit .env.
# Pin SEMAPHORE_TAG to a release you have tested (see github.com/semaphoreui/semaphore/releases).
SEMAPHORE_TAG=latest
SEMAPHORE_PORT=3000
TZ=America/Sao_Paulo

POSTGRES_USER=semaphore
POSTGRES_DB=semaphore
POSTGRES_PASSWORD=__GENERATE__

SEMAPHORE_ADMIN=admin
SEMAPHORE_ADMIN_NAME=Administrator
SEMAPHORE_ADMIN_EMAIL=admin@example.com
SEMAPHORE_ADMIN_PASSWORD=__GENERATE__
SEMAPHORE_ACCESS_KEY_ENCRYPTION=__GENERATE__
